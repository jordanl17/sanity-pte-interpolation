{
  "name": "pte-interpolation-react",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "React components for rendering Portable Text with interpolated values",
  "keywords": [
    "sanity",
    "portable-text",
    "interpolation",
    "react"
  ],
  "homepage": "https://github.com/jordanl17/sanity-pte-interpolation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanl17/sanity-pte-interpolation.git",
    "directory": "packages/pte-interpolation-react"
  },
  "bugs": {
    "url": "https://github.com/jordanl17/sanity-pte-interpolation/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "browserslist": "extends @sanity/browserslist-config",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "link-watch": "pkg-utils watch --tsconfig tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "yalc:publish": "npx yalc publish"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.2",
    "pte-interpolation-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^10.4.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  }
}
