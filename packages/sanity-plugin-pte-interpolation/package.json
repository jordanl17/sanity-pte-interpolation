{
  "name": "sanity-plugin-pte-interpolation",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Sanity Studio plugin for interpolating values into Portable Text Editor fields",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "portable-text",
    "interpolation"
  ],
  "homepage": "https://github.com/jordanl17/sanity-pte-interpolation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanl17/sanity-pte-interpolation.git",
    "directory": "packages/sanity-plugin-pte-interpolation"
  },
  "bugs": {
    "url": "https://github.com/jordanl17/sanity-pte-interpolation/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "browserslist": "extends @sanity/browserslist-config",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "link-watch": "pkg-utils watch --tsconfig tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "yalc:publish": "npx yalc publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "sanity": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^10.4.4",
    "@sanity/plugin-kit": "^4.0.20",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  }
}
